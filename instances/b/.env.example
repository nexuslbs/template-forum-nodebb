# instances/b/.env.example: instance B of template-forum-nodebb.
# Copy to instances/b/.env (gitignored) and run with ENV_FILE=instances/b/.env
# from the repository root. Same key set as the template .env.example plus the
# instance overrides RUNTIME_DIR and PLUGINS_MANIFEST. Throwaway credentials ONLY.
#
#   cp instances/b/.env.example instances/b/.env
#   ENV_FILE="$PWD/instances/b/.env" scripts/up.sh
#   ENV_FILE="$PWD/instances/b/.env" scripts/bootstrap.sh
#   ENV_FILE="$PWD/instances/b/.env" scripts/apply.sh
#   ENV_FILE="$PWD/instances/b/.env" scripts/verify.sh

# --- Compose project -------------------------------------------------------
# One project per instance so containers and volumes never collide.
COMPOSE_PROJECT_NAME=template-forum-nodebb-b

# --- Per-instance runtime --------------------------------------------------
# DISTINCT from instance A: this instance keeps its own rendered config.json
# and mongo init script under instances/b/runtime. The leading ./ makes Compose
# treat it as a bind mount (a bare relative path would be a named volume).
RUNTIME_DIR=./instances/b/runtime

# --- NodeBB image ----------------------------------------------------------
# OFFICIAL GHCR image, pinned. Bump only through scripts/migrate.sh.
NODEBB_IMAGE_TAG=4.16.1

# --- Public address --------------------------------------------------------
# Instance B serves on its own loopback port.
NODEBB_URL=http://localhost:4571
NODEBB_BIND_ADDR=127.0.0.1
NODEBB_PORT=4571

# --- First admin (consumed by scripts/bootstrap.sh through NODEBB_ADMIN_*) --
NODEBB_ADMIN_USERNAME=admin
NODEBB_ADMIN_EMAIL=admin-b@example.com
NODEBB_ADMIN_PASSWORD=change-me-admin-password

# --- Database: MongoDB 7 ---------------------------------------------------
NODEBB_DB=mongo
NODEBB_DB_HOST=mongo
NODEBB_DB_PORT=27017
NODEBB_DB_USER=nodebb
NODEBB_DB_PASSWORD=change-me-db-password
NODEBB_DB_NAME=nodebb

# --- NodeBB secret ---------------------------------------------------------
NODEBB_SECRET=change-me-nodebb-secret

# --- Plugin/theme manifest override ---------------------------------------
# Instance B installs the persona theme (a DIFFERENT theme from instance A)
# and no plugin. The template's own config/plugins.json is never edited.
PLUGINS_MANIFEST=instances/b/plugins.json

# --- Config template override ---------------------------------------------
CONFIG_TEMPLATE=
