# template-forum-nodebb PRODUCTION environment EXAMPLE.
#
# Copy to .env on the production host and fill the real values from the operator
# secret store. This file holds placeholders only and NEVER a real secret.
#
# It has EXACTLY the same key set as .env.example (the local sandbox): the
# sandbox <-> production switch is a .env value diff only. See docs/RUNBOOK.md
# section 8. Prove the key set with:
#   diff <(grep -oE '^[A-Z_]+=' .env.example | sort) \
#        <(grep -oE '^[A-Z_]+=' production.env.example | sort)
# which must print nothing.

# --- Compose project -------------------------------------------------------
# A production project name, never the protected production project omni-stack.
COMPOSE_PROJECT_NAME=template-forum-nodebb-prod

# --- NodeBB image ----------------------------------------------------------
# Same official GHCR image and tag as the sandbox. Bump only through
# scripts/migrate.sh.
NODEBB_IMAGE_TAG=4.16.1

# --- Public address --------------------------------------------------------
# The real public URL. No trailing slash.
NODEBB_URL=https://forum.example.com
# Publish on the loopback and put a TLS terminator (reverse proxy) in front of
# it. Set 0.0.0.0 only when the host firewall protects the port.
NODEBB_BIND_ADDR=127.0.0.1
NODEBB_PORT=4567

# --- First admin (consumed by scripts/bootstrap.sh through NODEBB_ADMIN_*) --
NODEBB_ADMIN_USERNAME=admin
NODEBB_ADMIN_EMAIL=owner@example.com
NODEBB_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# --- Database: MongoDB 7 ---------------------------------------------------
NODEBB_DB=mongo
NODEBB_DB_HOST=mongo
NODEBB_DB_PORT=27017
NODEBB_DB_USER=nodebb
NODEBB_DB_PASSWORD=CHANGE_ME_DB_PASSWORD
NODEBB_DB_NAME=nodebb

# --- NodeBB secret ---------------------------------------------------------
# Signs sessions and cookies. Generate with: openssl rand -base64 24
NODEBB_SECRET=CHANGE_ME_NODEBB_SECRET

# --- Plugin/theme manifest override ---------------------------------------
# Leave empty to use config/plugins.json, or point at the project's own file.
PLUGINS_MANIFEST=

# --- Config template override ---------------------------------------------
# Leave empty to use config/config.json.tpl, or point at the project's own file.
CONFIG_TEMPLATE=
