# Copy to .env and edit, or just run scripts/up.sh: it creates .env from this
# file and fills every `change-me-*` placeholder with an `openssl rand -base64 24`
# throwaway value. .env is gitignored; this file holds placeholders ONLY.

# --- Compose project -------------------------------------------------------
# Prefix for container/volume names. One project per stack. The scripts refuse
# to run when this is the protected production project (omni-stack).
COMPOSE_PROJECT_NAME=template-forum-nodebb

# --- NodeBB image ----------------------------------------------------------
# OFFICIAL image, PINNED (never `latest`). The GHCR image is the official one;
# the Docker Hub `nodebb/docker` repo is stale (last release 2023, no 4.x).
# Verify with: docker manifest inspect ghcr.io/nodebb/nodebb:4.16.1
NODEBB_IMAGE_TAG=4.16.1

# --- Public address --------------------------------------------------------
# The URL NodeBB serves and uses to build absolute links. No trailing slash.
NODEBB_URL=http://localhost:4567
# Host interface and port the NodeBB container is published on.
NODEBB_BIND_ADDR=127.0.0.1
NODEBB_PORT=4567

# --- First admin (consumed by scripts/bootstrap.sh through NODEBB_ADMIN_*) --
# NodeBB rejects passwords shorter than 6 chars / strength < 1.
NODEBB_ADMIN_USERNAME=admin
NODEBB_ADMIN_EMAIL=admin@example.com
NODEBB_ADMIN_PASSWORD=change-me-admin-password

# --- Database: MongoDB 7 ---------------------------------------------------
# NodeBB's own docker-compose.yml ships mongo:7-jammy as the DEFAULT service
# (no profile gate) and the official upgrade doc documents `mongodump` for
# backup. Postgres/Redis are opt-in profiles or extra files. One DB, chosen and
# documented.
NODEBB_DB=mongo
NODEBB_DB_HOST=mongo
NODEBB_DB_PORT=27017
NODEBB_DB_USER=nodebb
NODEBB_DB_PASSWORD=change-me-db-password
NODEBB_DB_NAME=nodebb

# --- NodeBB secret ---------------------------------------------------------
# Signs sessions and cookies. Generated locally when left as a placeholder.
NODEBB_SECRET=change-me-nodebb-secret

# --- Plugin/theme manifest override ---------------------------------------
# Defaults to config/plugins.json. A consuming project can point at its own
# manifest without editing the template.
PLUGINS_MANIFEST=

# --- Config template override ---------------------------------------------
# Defaults to config/config.json.tpl. A consuming project can point at its own
# NodeBB config.json template without editing the template.
CONFIG_TEMPLATE=
